            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "brsnmp: Run Release",
            "type": "shell",
            "command": "bin\\Release\\brsnmp.exe",
            "args": [
                "--help"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "dependsOn": [
